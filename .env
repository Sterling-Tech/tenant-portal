# Tenant Portal Environment Configuration
#PORT=3002
#NODE_ENV=production
#REACT_APP_API_URL=http://188.166.161.13:3002
#REACT_APP_NAME=QuickCash Tenant Portal
# =============================================================================
# QuickCash Tenant Portal Environment Configuration
# =============================================================================
# This file contains all configurable parameters for the Tenant Portal
# Copy this file to frontend/tenant-portal/.env and update values as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Port on which the tenant portal will run
PORT=3002

# Application environment: development, production, staging
NODE_ENV=production

# Application name
REACT_APP_NAME=QuickCash Tenant Portal

# Application version
REACT_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
# Backend API base URL (without trailing slash)
# For production: http://188.166.161.13:8001/api/v1
# For local development: http://188.166.161.13:8001/api/v1
# REACT_APP_API_URL=http://188.166.161.13:8001/api/v1
# REACT_APP_API_URL=http://188.166.99.136:8061

#REACT_APP_API_URL=http://188.166.161.13:8061

#new server
REACT_APP_API_URL=http://188.166.161.13:8065

#Map Refund API base URL
REACT_APP_REFUND_API_URL=http://165.227.77.33:8001/api

# API timeout in milliseconds (default: 30000 = 30 seconds)
REACT_APP_API_TIMEOUT=30000

# Enable/disable API request logging
REACT_APP_API_LOGGING=true

# API request retry attempts
REACT_APP_API_RETRY_ATTEMPTS=3

# API request retry delay in milliseconds
REACT_APP_API_RETRY_DELAY=1000

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# Token storage key name (localStorage key)
REACT_APP_AUTH_TOKEN_KEY=auth_token

# User storage key name (localStorage key)
REACT_APP_AUTH_USER_KEY=auth_user

# Session timeout in milliseconds (default: 24 hours)
REACT_APP_SESSION_TIMEOUT=86400000

# Enable/disable two-factor authentication
REACT_APP_ENABLE_2FA=true

# Enable/disable remember me functionality
REACT_APP_ENABLE_REMEMBER_ME=true

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable tenant settings management
REACT_APP_ENABLE_TENANT_SETTINGS=true

# Enable/disable user management
REACT_APP_ENABLE_USER_MANAGEMENT=true

# Enable/disable organization management
REACT_APP_ENABLE_ORGANIZATION_MANAGEMENT=true

# Enable/disable billing and subscription
REACT_APP_ENABLE_BILLING=true

# Enable/disable usage analytics
REACT_APP_ENABLE_USAGE_ANALYTICS=true

# Enable/disable dashboard widgets
REACT_APP_ENABLE_DASHBOARD_WIDGETS=true

# Enable/disable notifications
REACT_APP_ENABLE_NOTIFICATIONS=true

# Enable/disable help center
REACT_APP_ENABLE_HELP_CENTER=true

# -----------------------------------------------------------------------------
# UI/UX Configuration
# -----------------------------------------------------------------------------
# Default theme: light, dark, auto
REACT_APP_DEFAULT_THEME=light

# Enable/disable dark mode
REACT_APP_ENABLE_DARK_MODE=true

# Default language/locale
REACT_APP_DEFAULT_LOCALE=en

# Currency code (ISO 4217)
REACT_APP_CURRENCY_CODE=NGN

# Currency symbol
REACT_APP_CURRENCY_SYMBOL=₦

# Date format
REACT_APP_DATE_FORMAT=DD/MM/YYYY

# Time format
REACT_APP_TIME_FORMAT=HH:mm

# Items per page (pagination)
REACT_APP_ITEMS_PER_PAGE=20

# -----------------------------------------------------------------------------
# Business Logic Configuration
# -----------------------------------------------------------------------------
# Enable/disable multi-tenant mode
REACT_APP_MULTI_TENANT=true

# Current tenant ID (set dynamically or via login)
# REACT_APP_TENANT_ID=

# Enable/disable role-based access control
REACT_APP_ENABLE_RBAC=true

# Enable/disable audit logging
REACT_APP_ENABLE_AUDIT_LOG=true

# Maximum number of users per tenant
# REACT_APP_MAX_USERS_PER_TENANT=100

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Enable/disable HTTPS only (production)
REACT_APP_FORCE_HTTPS=false

# Content Security Policy (CSP) enabled
REACT_APP_CSP_ENABLED=true

# Enable/disable XSS protection
REACT_APP_XSS_PROTECTION=true

# -----------------------------------------------------------------------------
# Analytics & Monitoring
# -----------------------------------------------------------------------------
# Enable/disable analytics tracking
REACT_APP_ENABLE_ANALYTICS=false

# Analytics provider (google, mixpanel, etc.)
# REACT_APP_ANALYTICS_PROVIDER=

# Analytics tracking ID
# REACT_APP_ANALYTICS_ID=

# Enable/disable error tracking
REACT_APP_ENABLE_ERROR_TRACKING=true

# Error tracking service (sentry, etc.)
# REACT_APP_ERROR_TRACKING_DSN=

# -----------------------------------------------------------------------------
# Development & Debugging
# -----------------------------------------------------------------------------
# Enable/disable debug mode
REACT_APP_DEBUG=false

# Enable/disable verbose logging
REACT_APP_VERBOSE_LOGGING=false

# Enable/disable React DevTools in production
REACT_APP_ENABLE_DEVTOOLS=false

# Source map generation (development only)
GENERATE_SOURCEMAP=false

# -----------------------------------------------------------------------------
# Performance Configuration
# -----------------------------------------------------------------------------
# Enable/disable code splitting
REACT_APP_ENABLE_CODE_SPLITTING=true

# Enable/disable lazy loading
REACT_APP_ENABLE_LAZY_LOADING=true

# Enable/disable service worker
REACT_APP_ENABLE_SERVICE_WORKER=false

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------
# Support/Help desk URL
# REACT_APP_SUPPORT_URL=https://support.quickcash.com

# Documentation URL
# REACT_APP_DOCS_URL=https://docs.quickcash.com

# Terms of Service URL
# REACT_APP_TERMS_URL=https://quickcash.com/terms

# Privacy Policy URL
# REACT_APP_PRIVACY_URL=https://quickcash.com/privacy

# -----------------------------------------------------------------------------
# Build Configuration
# -----------------------------------------------------------------------------
# Build output directory
REACT_APP_BUILD_DIR=build

# Public URL (for asset paths)
# REACT_APP_PUBLIC_URL=

# =============================================================================
# End of Tenant Portal Configuration
# =============================================================================
