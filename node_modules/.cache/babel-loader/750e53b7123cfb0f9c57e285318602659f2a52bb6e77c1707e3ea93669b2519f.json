{"ast":null,"code":"import{createSlice}from'@reduxjs/toolkit';const initialState={wallet:null,transactions:[],isLoading:false};const walletSlice=createSlice({name:'wallet',initialState,reducers:{setWallet:(state,action)=>{state.wallet=action.payload;},setTransactions:(state,action)=>{state.transactions=action.payload;},addTransaction:(state,action)=>{state.transactions.unshift(action.payload);},setLoading:(state,action)=>{state.isLoading=action.payload;}}});export const{setWallet,setTransactions,addTransaction,setLoading}=walletSlice.actions;export default walletSlice.reducer;","map":null,"metadata":{},"sourceType":"module","externalDependencies":[]}