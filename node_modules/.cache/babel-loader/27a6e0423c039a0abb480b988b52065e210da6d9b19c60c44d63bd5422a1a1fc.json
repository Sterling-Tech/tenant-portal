{"ast":null,"code":"import{createSlice}from'@reduxjs/toolkit';const initialState={roster:[],searchTerm:'',filters:{}};const agentSlice=createSlice({name:'agent',initialState,reducers:{setRoster:(state,action)=>{state.roster=action.payload;},setSelectedAgent:(state,action)=>{state.selectedAgentId=action.payload;},setSearchTerm:(state,action)=>{state.searchTerm=action.payload;},setFilters:(state,action)=>{state.filters=action.payload;},upsertAgent:(state,action)=>{const existing=state.roster.findIndex(agent=>agent.id===action.payload.id);if(existing>=0){state.roster[existing]=action.payload;}else{state.roster.push(action.payload);}}}});export const{setRoster,setSelectedAgent,setSearchTerm,setFilters,upsertAgent}=agentSlice.actions;export default agentSlice.reducer;","map":null,"metadata":{},"sourceType":"module","externalDependencies":[]}